digraph FairShare {
 graph [rankdir=LR, bgcolor="white", fontname="DejaVu Sans", nodesep=0.55, ranksep=0.8, pad=0.3];
 node [shape=box, style="rounded,filled", fillcolor="#f0edff", color="#c3b5f2", fontname="DejaVu Sans", fontsize=14, margin="0.2,0.15"];
 edge [color="#9a8abf", fontname="DejaVu Sans", fontsize=10];
 Browser [label="Web client\nReact / TypeScript / Vite"];
 API [label="Modular monolith\nNode.js / Fastify"];
 DB [shape=cylinder, label="PostgreSQL\nPGlite locally / pg externally",fillcolor="#eaf3fc",color="#abc9df"];
 subgraph cluster_modules {
  label="Server modules"; fontname="DejaVu Sans";fontsize=12;color="#e5e8f0";style=rounded;
  Identity [label="Accounts and sessions"];
  Planning [label="Teams, projects, tasks"];
  Allocation [label="Workload allocation"];
  Collaboration [label="Discussions and decisions"];
 }
 Browser -> API [label="HTTPS / JSON\nHttpOnly session"];
 API -> Identity;
 API -> Planning;
 API -> Allocation;
 API -> Collaboration;
 Identity -> DB [label="Parameterized SQL"];
 Planning -> DB;
 Allocation -> DB [label="Snapshot and transaction"];
 Collaboration -> DB;
}
